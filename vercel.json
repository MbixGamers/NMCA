{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index?route=/uploads/:path*"
    }
  ],
  "outputDirectory": "public"
}
