{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?route=/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index?route=/uploads/:path*"
    },
    {
      "source": "/MAP.pdf",
      "destination": "/api/index?route=/MAP.pdf"
    }
  ],
  "outputDirectory": "public"
}
